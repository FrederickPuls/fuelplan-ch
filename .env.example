# FuelPlan CH – Phase 1
# Kopiere diese Datei nach .env und trage deine echten Werte ein.
# .env ist in .gitignore und wird NIE in CLAUDE.md, notes.md, runs/ oder andere Dateien kopiert.

# intervals.icu → Settings → Developer Settings → API Key (nur Lesezugriff nötig)
INTERVALS_API_KEY=

# intervals.icu Athlete-ID, steht in der URL: https://intervals.icu/athlete/i123456/...
INTERVALS_ATHLETE_ID=

# OpenRouter → Settings → API Keys (Key "fuelplan-ch" mit Ausgabenlimit, z. B. 10 USD)
# Wird verwendet, wenn LLM_PROVIDER=openrouter (Standard, siehe fuelplan/config.py)
OPENROUTER_API_KEY=

# Optional: direkte Anthropic-API für einen späteren Wechsel (LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Persönliche Einstellungen (optional, sonst gelten die Beispielwerte aus dem Code)
# Körpergewicht in kg für die g/kg-Rechnungen (fuelplan/nutrition/rules.py), Standard 70
FUELPLAN_WEIGHT_KG=
# Postleitzahl für die Filialsuche (fuelplan/grocery/stores.json), Standard 8001
FUELPLAN_ZIP=
# Absoluter Pfad zu npx, falls es nicht im PATH liegt (z. B. bei nvm)
FUELPLAN_NPX=

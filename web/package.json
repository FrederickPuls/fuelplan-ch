{
  "name": "fuelplan-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "FuelPlan CH – Frontend (PWA) für Phase 2. Zeigt nur an, was die API unter /api liefert.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "contrast": "node scripts/contrast.mjs",
    "icons": "node scripts/icons.mjs",
    "screenshots": "playwright test --config playwright.config.ts",
    "screenshots:readme": "playwright test --config playwright.readme.config.ts",
    "social-preview": "node scripts/social-preview.mjs"
  },
  "dependencies": {
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0"
  }
}
